# ==============================================================================
# TokiConvert Environment Configuration
# ==============================================================================

# PROXY_SECRET (CRITICAL):
# Cryptographic secret used to sign and verify HMAC-SHA256 tokens for media downloads.
# - In PRODUCTION: REQUIRED, must be at least 32 characters long. The application will FAIL-CLOSED if missing.
# - In DEVELOPMENT: Optional (defaults to deterministic local development secret).
#
# Generate a secure 32+ character random secret using:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# SECURITY WARNING:
# NEVER commit your production secret to version control.
# NEVER expose this variable with a NEXT_PUBLIC_ prefix.
PROXY_SECRET=
